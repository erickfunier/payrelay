# Required. Format: tenant-id:api-key,another-tenant:another-api-key
# Generate a unique random API key for every tenant; do not commit real keys.
PAYRELAY_API_KEYS=merchant_demo:prk_replace_with_a_random_key_at_least_20_characters

PAYRELAY_ADDR=:8080
PAYRELAY_DB_PATH=./payrelay.db
PAYRELAY_WORKER_POLL=500ms
PAYRELAY_MAX_ATTEMPTS=5
PAYRELAY_REQUEST_TIMEOUT=10s
