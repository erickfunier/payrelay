{
  "info": {
    "_postman_id": "6fc28b68-8040-46f6-a8d3-1db5c9bc3907",
    "name": "PayRelay Local API",
    "description": "Requests for PayRelay's mock payment-event webhook API. Set baseUrl to the running server. This collection must only contain synthetic payment data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiKey", "value": "prk_replace_with_your_local_key" },
    { "key": "endpointId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "deliveryId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/healthz" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', function () { pm.response.to.have.status(200); });", "pm.test('reports ready', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"] } }]
    },
    {
      "name": "Create endpoint",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"url\": \"http://host.docker.internal:9000/webhooks/payrelay\"\n}" },
        "url": "{{baseUrl}}/v1/endpoints"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.id).to.match(/^we_/);", "pm.expect(body.secret).to.match(/^whsec_/);", "pm.collectionVariables.set('endpointId', body.id);"] } }]
    },
    {
      "name": "List endpoints",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/endpoints" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().data).to.be.an('array');"] } }]
    },
    {
      "name": "Create mock payment event",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Idempotency-Key", "value": "postman-{{$timestamp}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"type\": \"payment.succeeded\",\n  \"merchant_reference\": \"postman-demo-1007\",\n  \"amount_cents\": 2599,\n  \"currency\": \"USD\",\n  \"status\": \"succeeded\"\n}" },
        "url": "{{baseUrl}}/v1/events"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.expect(body.event.id).to.match(/^evt_/);", "pm.collectionVariables.set('eventId', body.event.id);"] } }]
    },
    {
      "name": "Get event",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/events/{{eventId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "List event deliveries",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/events/{{eventId}}/deliveries" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', function () { pm.response.to.have.status(200); });", "const deliveries = pm.response.json().data;", "if (deliveries.length) { pm.collectionVariables.set('deliveryId', deliveries[0].id); }"] } }]
    },
    {
      "name": "List delivery attempts",
      "request": { "method": "GET", "url": "{{baseUrl}}/v1/deliveries/{{deliveryId}}/attempts" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('returns 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Replay failed delivery",
      "request": { "method": "POST", "url": "{{baseUrl}}/v1/deliveries/{{deliveryId}}/replay" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('queues replay or explains why it cannot', function () { pm.expect([202, 409]).to.include(pm.response.code); });"] } }]
    }
  ]
}
